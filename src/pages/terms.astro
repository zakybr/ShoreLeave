<ServicePage
  title="Terms of Service | Shore Leave"
  description="Shore Leave terms: quotes, key holding, damage reporting, cancellations and our weather policy, in plain English."
  crumb="Terms"
  h1="Terms"
  lede="The plain-English version of how we work together."
