---
import ServicePage from '../../layouts/ServicePage.astro';
import { SITE } from '../../config';
---

<ServicePage
  title="Book a Boat Reset, Auckland | Shore Leave"
  description="Book a boat clean or fridge restock in Auckland. Tell us about the boat and we’ll send a quote. Takes under two minutes, and there’s no obligation."
  crumb="Enquire"
  h1="Enquire now"
  lede="Tell us about the boat. You’ll get a quote before anything starts, and your first reset is 50% off."
  og="book"
  hideCta
>
  <div class="wrap band lg:grid lg:grid-cols-12 lg:gap-12">
    <form id="book" method="post" action="/api/book" class="lg:col-span-7 lg:pl-[var(--indent)] grid gap-6" novalidate>
      <div class="grid sm:grid-cols-2 gap-6">
        <div class="field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required /></div>
        <div class="field"><label for="mobile">Mobile</label><input id="mobile" name="mobile" type="tel" autocomplete="tel" inputmode="tel" required /></div>
      </div>
      <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" inputmode="email" required /></div>

      <div class="grid sm:grid-cols-2 gap-6">
        <div class="field">
          <label for="boat_type">Boat type</label>
          <select id="boat_type" name="boat_type" required>
            <option value="">Choose one</option>
            <option>Trailer boat at home</option>
            <option>Berthed at Pine Harbour</option>
            <option>Other</option>
          </select>
        </div>
        <div class="field"><label for="boat_length">Boat length (ft)</label><input id="boat_length" name="boat_length" type="number" inputmode="numeric" min="8" max="200" required /></div>
      </div>
      <div class="field"><label for="location">Location: berth and pier, or suburb</label><input id="location" name="location" required /></div>

      <fieldset class="field">
        <legend>What would you like done?</legend>
        <div class="mt-2 grid gap-3">
          <label class="check"><input type="checkbox" name="services" value="Post-trip reset" /> Post-trip reset</label>
          <label class="check"><input type="checkbox" name="services" value="Beds and linen" /> Beds and linen</label>
          <label class="check"><input type="checkbox" name="services" value="Fridge and pantry restock" /> Fridge and pantry restock</label>
        </div>
      </fieldset>

      <div class="grid sm:grid-cols-2 gap-6">
        <div class="field"><label for="date">Preferred date</label><input id="date" name="date" type="date" required /></div>
        <div class="field">
          <label for="time_window">Time window</label>
          <select id="time_window" name="time_window">
            <option>Any time</option>
            <option>Morning</option>
            <option>Afternoon</option>
            <option>Evening</option>
          </select>
        </div>
      </div>

      <div class="field"><label for="notes">Restock list or notes</label><textarea id="notes" name="notes" maxlength="3000"></textarea></div>

      <div class="field">
        <label for="heard">How did you hear about us?</label>
        <select id="heard" name="heard">
          <option value="">Choose one</option>
          <option>Google</option>
          <option>AI search</option>
          <option>At the marina</option>
          <option>Friend or family</option>
          <option>Social media</option>
          <option>Other</option>
        </select>
      </div>

      <!-- Honeypot: hidden from people, tempting to bots -->
      <div style="position:absolute;left:-9999px" aria-hidden="true">
        <label for="company">Company</label><input id="company" name="company" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="t" id="t" />

      <label class="check">
        <input type="checkbox" name="consent" value="yes" required />
        <span>I agree to Shore Leave using these details to reply to me, as set out in the <a href="/privacy" class="underline">privacy policy</a>.</span>
      </label>

      <p id="err" role="alert" class="font-semibold empty:hidden"></p>
      <button type="submit" class="btn btn-ink w-full sm:w-auto" id="go">Send for a quote</button>
    </form>

    <aside class="lg:col-span-4 lg:col-start-9 mt-12 lg:mt-0">
      <div class="card">
        <h2 class="!text-3xl">Rather talk?</h2>
        <p>Call or text from the pontoon. It’s a real person, usually Zak or Bozzy.</p>
        <div class="grid gap-1">
          <a class="underline font-semibold" href={`tel:${SITE.phoneTel}`} data-track="click_call">Call {SITE.phoneDisplay}</a>
          <a class="underline font-semibold" href={`sms:${SITE.phoneTel}`} data-track="click_sms">Text {SITE.phoneDisplay}</a>
        </div>
      </div>
    </aside>
  </div>
</ServicePage>

<script>
  const form = document.getElementById('book') as HTMLFormElement;
  const err = document.getElementById('err') as HTMLElement;
  const go = document.getElementById('go') as HTMLButtonElement;
  (document.getElementById('t') as HTMLInputElement).value = String(Date.now());
  (document.getElementById('date') as HTMLInputElement).min = new Date().toISOString().slice(0, 10);

  const wanted = new URLSearchParams(location.search).get('service');
  if (wanted) form.querySelectorAll<HTMLInputElement>('[name=services]').forEach((c) => { c.checked = c.value === wanted; });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.textContent = '';
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    if (!data.getAll('services').length) {
      err.textContent = 'Tick at least one service, so we know what to quote.';
      return;
    }
    go.disabled = true;
    go.textContent = 'Sending';
    try {
      const body = { ...Object.fromEntries(data), services: data.getAll('services') };
      const res = await fetch('/api/book', { method: 'POST', headers: { 'content-type': 'application/json', accept: 'application/json' }, body: JSON.stringify(body) });
      const out = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(out.error);
      location.href = '/book/thanks';
    } catch (x) {
      err.textContent = (x as Error).message || 'That did not send. Call or text 022 305 3853 and we will sort it out.';
      go.disabled = false;
      go.textContent = 'Send for a quote';
    }
  });
</script>
