---
import ServicePage from '../layouts/ServicePage.astro';
import Faq from '../components/Faq.astro';
import { SITE } from '../config';
import { faqPage } from '../lib/schema';
import { beachlands, charter, eastAuckland, general, northShore, pineHarbour, pricing, provisioning, reset, valet, winter } from '../data/qa';

const groups = [
  { heading: 'About Shore Leave', items: general },
  { heading: 'Essential Reset', items: reset },
  { heading: 'Valet', items: valet },
  { heading: 'Provisioning', items: provisioning },
  { heading: 'Charter Ready', items: charter },
  { heading: 'Winter Boat Sitting', items: winter },
  { heading: 'North Shore', items: northShore },
  { heading: 'Pine Harbour and Beachlands', items: [...pineHarbour, ...beachlands] },
  { heading: 'East Auckland', items: eastAuckland },
  { heading: 'Pricing', items: pricing },
];
---

<ServicePage
  title="Boat Cleaning FAQ, Auckland | Shore Leave"
  description="Answers on boat valets, provisioning, detailing, marina berths, Pine Harbour access, pricing and what happens if the weather turns. From Shore Leave."
  crumb="FAQ"
  h1="Questions, answered straight."
  lede={`Can’t find yours? Call or text ${SITE.phoneDisplay}.`}
  faqs={[]}
  links={[
    { href: '/book', label: 'Enquire now' },
    { href: '/about', label: 'How we work' },
    { href: '/pricing', label: 'How quotes work' },
  ]}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqPage(groups.flatMap((g) => g.items)))} />
  <div class="wrap band grid gap-14 lg:gap-20">
    {groups.map((g) => <section><Faq items={g.items} heading={g.heading} open /></section>)}
  </div>
</ServicePage>
