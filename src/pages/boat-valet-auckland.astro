---
import ServicePage from '../layouts/ServicePage.astro';
import Arrow from '../components/Arrow.astro';
import { BEDS_FACTS, VALET_LIST } from '../config';
import { valet } from '../data/qa';
import photo from '../assets/photos/cabin.jpg';
---

<ServicePage
  title="Boat Valet Auckland | Beds and Full Interior | Shore Leave"
  description="Boat valet in Auckland: a full interior clean, beds made with your linen and attention to the detail. On the berth or the trailer. Done after you’ve gone."
  crumb="Valet"
  h1="Boat valet, Auckland. Done after you’ve gone."
  lede="More thorough, with an eye for the detail. A full interior clean, beds made, and everything in its place when you come back."
  photo={photo}
  photoAlt="Inside a boat cabin, with late sun coming through the companionway"
  faqs={valet}
  serviceName="Boat valet"
  og="valet"
>
  <section class="wrap band">
    <div class="inset flow">
      <h2 class="title">What gets done</h2>
      <p class="lede">Everything in the <a class="underline" href="/boat-cleaning-auckland">Essential Reset</a>, then the work that makes a boat feel looked after.</p>
      <ul class="crosses">{VALET_LIST.map((t) => <li>{t}</li>)}</ul>
    </div>
  </section>
  <section id="beds" class="bg-beige-2">
    <div class="wrap band">
      <div class="inset flow">
        <h2 class="title">Boat bed making, with your linen</h2>
        <p class="lede">Hotels don’t ask you to change the sheets before you check out. Neither do we.</p>
        <ul class="crosses">{BEDS_FACTS.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>
  <section class="wrap band">
    <div class="inset flow">
      <h2>Getting guests aboard, or selling up?</h2>
      <p>Charter Ready takes the Valet further: seats and upholstery brought back by hand, and the superstructure detailed top to bottom.</p>
      <a href="/boat-detailing-auckland" class="go">See Charter Ready <Arrow /></a>
    </div>
  </section>
</ServicePage>
