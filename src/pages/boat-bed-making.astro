---
import ServicePage from '../layouts/ServicePage.astro';
import { BEDS_FACTS, FRESH_BEDS } from '../config';
import { beds } from '../data/qa';
import photo from '../assets/photos/cabin.jpg';
---

<ServicePage
  title="Boat Bed Making Service, Auckland | Fresh Beds | Shore Leave"
  description="Boat bed making service in Auckland, using the boat linen already on board. Add Fresh Beds to a reset or restock and come back to made beds."
  crumb="Boat bed making"
  h1="Come back to made beds."
  lede="We strip the beds and remake them with the clean linen already on board. You just turn up."
  photo={photo}
  photoAlt="Inside a boat cabin, with late sun coming through the companionway"
  faqs={beds}
  serviceName={FRESH_BEDS.name}
  og="beds"
  book="/book?service=Fresh%20Beds"
  links={[
    { href: '/book?service=Fresh%20Beds', label: 'Enquire now' },
    { href: '/boat-valet-auckland', label: 'Boat valet' },
    { href: '/boat-fridge-restock', label: 'Fridge restock' },
    { href: '/pricing', label: 'How quotes work' },
  ]}
>
  <section class="wrap band">
    <div class="inset flow">
      <h2 class="title">How Fresh Beds works</h2>
      <ol class="steps">
        <li>
          <b>1</b>
          <h3>Tell us</h3>
          <p>How many beds, and where the clean linen lives.</p>
        </li>
        <li>
          <b>2</b>
          <h3>We strip, bag and remake</h3>
          <p>Used linen goes in a bag, left aboard for you to take home.</p>
        </li>
        <li>
          <b>3</b>
          <h3>You come back</h3>
          <p>To made beds.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="bg-beige-2">
    <div class="wrap band">
      <div class="inset flow">
        <h2 class="title">Good to know</h2>
        <ul class="crosses">{BEDS_FACTS.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>
</ServicePage>
