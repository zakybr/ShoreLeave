---
import ServicePage from '../layouts/ServicePage.astro';
import { pineHarbour } from '../data/qa';
import photo from '../assets/photos/cabin.jpg';
---

<ServicePage
  title="How Shore Leave Works | Boat reset and restock, Auckland"
  description="How a Shore Leave boat reset works: book, we reset, you come back to a ready boat. Key handover, what we need from you and exactly what’s covered."
  crumb="How it works"
  h1="Book. We reset. You come back to a ready boat."
  lede="Three steps. Only the first one needs you."
  photo={photo}
  photoAlt="Inside a sailboat cabin, with daylight coming down the companionway"
  faqs={[pineHarbour[1]]}
  links={[
    { href: '/book', label: 'Enquire now' },
    { href: '/pricing', label: 'How quotes work' },
    { href: '/pine-harbour-boat-cleaning', label: 'Pine Harbour berths' },
    { href: '/terms', label: 'Terms' },
  ]}
>
  <section class="wrap band">
    <div class="inset flow">
      <h2 class="title">The three steps</h2>
      <ol class="steps">
        <li>
          <b>1</b>
          <h3>Book</h3>
          <p>Fill in the form or call. We’ll reply with a quote and agree on access.</p>
        </li>
        <li>
          <b>2</b>
          <h3>We reset</h3>
          <p>We get aboard at the agreed time and work through the list, with photos before and after. If we spot anything you should know about, we’ll tell you.</p>
        </li>
        <li>
          <b>3</b>
          <h3>You come back</h3>
          <p>We lock up and send you a short note. The deck’s clean, the beds are made and the fridge is sorted.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="bg-beige-2">
    <div class="wrap band">
      <div class="inset flow">
        <h2 class="title">What we need from you</h2>
        <ul class="crosses">
          <li>Your boat’s location: pier and berth, or home address</li>
          <li>A way aboard, agreed before the first job</li>
          <li>Fresh water at the berth, or an outside tap at home</li>
          <li>Your restock list, if you want one</li>
          <li>Where your spare linen is kept</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap band">
    <div class="inset flow">
      <h2 class="title">What’s not included</h2>
      <p class="lede">We work on deck and inside the boat. That’s the whole scope.</p>
      <p>Engines, electrics and repairs aren’t us. If we notice something that needs a specialist, we’ll tell you and you can decide what to do about it.</p>
    </div>
  </section>
</ServicePage>
