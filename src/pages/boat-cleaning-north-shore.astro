---
import ServicePage from '../layouts/ServicePage.astro';
import { northShore } from '../data/qa';
import photo from '../assets/photos/deck-sunpad.jpg';
---

<ServicePage
  place
  title="Boat Cleaning North Shore | Berth or Trailer | Shore Leave"
  description="Boat cleaning on Auckland’s North Shore, on the berth or on the trailer at home. Valets, provisioning and detailing, from Devonport to Long Bay."
  crumb="Boat cleaning North Shore"
  h1="North Shore boats. Berth or driveway."
  lede="Tie up or tow home. We come to wherever the boat ends up, from Devonport to Long Bay."
  photo={photo}
  photoAlt="Deck lounge on a modern boat with tan cushions laid out neatly, moored at a marina"
  faqs={northShore}
  serviceName="Boat cleaning on the North Shore"
  og="north-shore"
  ctaHeading="Back on the Shore? Leave the boat with us."
>
  <section class="wrap band">
    <div class="inset flow">
      <h2 class="title">Two kinds of North Shore boat</h2>
      <div class="grid gap-6">
        <div>
          <h3 class="sub">On the berth</h3>
          <p class="mt-1">Tell us your marina and berth. We’ll agree a way aboard and reset the boat where it lies, with no need for you to come back down.</p>
        </div>
        <div>
          <h3 class="sub">On the trailer</h3>
          <p class="mt-1">Home from a run to Rangitoto, Motutapu or Tiritiri Matangi? Leave it in the driveway. We bring everything to you.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="bg-beige-2">
    <div class="wrap band">
      <div class="inset flow">
        <h2>Clean boat, made beds, cold fridge</h2>
        <p>Same services as everywhere we work, from an Essential Reset to a full Valet. Add Provisioning and the boat’s ready before you are.</p>
      </div>
    </div>
  </section>
</ServicePage>
