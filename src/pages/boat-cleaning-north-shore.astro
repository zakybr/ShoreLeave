---
import ServicePage from '../layouts/ServicePage.astro';
import { northShore } from '../data/qa';
import photo from '../assets/photos/deck-sunpad.jpg';
---

<ServicePage
  place
  title="Boat Cleaning North Shore | Marina Berths | Shore Leave"
  description="Boat cleaning on Auckland’s North Shore, on your berth at Bayswater Marina or Gulf Harbour Marina. Valets, beds made, provisioning and detailing."
  crumb="Boat cleaning North Shore"
  h1="North Shore boats. Right on the berth."
  lede="Tie up at Bayswater or Gulf Harbour and head home. We’ll have the boat clean, made up and stocked for next time."
  photo={photo}
  photoAlt="Deck lounge on a modern boat with tan cushions laid out neatly, moored at a marina"
  faqs={northShore}
  serviceName="Boat cleaning on the North Shore"
  og="north-shore"
  ctaHeading="Back on the Shore? Leave the boat with us."
>
  <section class="wrap band">
    <div class="inset flow">
      <h2 class="title">Two North Shore marinas</h2>
      <div class="grid gap-6">
        <div>
          <h3 class="sub">Bayswater Marina</h3>
          <p class="mt-1">Tell us your pier and berth. We’ll agree a way aboard and reset the boat where it lies, with no need for you to come back down.</p>
        </div>
        <div>
          <h3 class="sub">Gulf Harbour Marina</h3>
          <p class="mt-1">Back from a run to Tiritiri Matangi or Kawau? Tie up and go. The boat’s reset on the berth, ready for the next good forecast.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="bg-beige-2">
    <div class="wrap band">
      <div class="inset flow">
        <h2>Clean boat, made beds, cold fridge</h2>
        <p>Same services as everywhere we work, from an Essential Reset to a full Valet. Add Provisioning and the boat’s ready before you are.</p>
      </div>
    </div>
  </section>
</ServicePage>
