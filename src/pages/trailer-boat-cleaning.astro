---
import ServicePage from '../layouts/ServicePage.astro';
import { trailer } from '../data/qa';
import photo from '../assets/photos/trailer-home.jpg';
---

<ServicePage
  place
  title="Trailer Boat Cleaning at Home, Auckland | Shore Leave"
  description="Trailer boat cleaning at your home in Auckland. Tow back from the ramp and we come to you. Beachlands, Maraetai, North Shore and Whangaparāoa."
  crumb="Trailer boat cleaning"
  h1="Back from the ramp? Leave it in the driveway."
  lede="We come to you and reset the boat on the trailer. The North Shore, Whangaparāoa, Beachlands and Maraetai."
  photo={photo}
  photoAlt="Fishing boat with a large outboard, parked on its trailer beside a house"
  faqs={trailer}
  serviceName="Trailer boat cleaning at home"
  og="trailer"
>
  <section class="wrap band">
    <div class="inset flow">
      <h2 class="title">Where the callouts run</h2>
      <dl class="grid gap-6">
        <div>
          <dt class="sub">North Shore</dt>
          <dd class="mt-1">Your driveway, after a trip across to Rangitoto or Motutapu. <a class="underline" href="/boat-cleaning-north-shore">More on the North Shore</a>.</dd>
        </div>
        <div>
          <dt class="sub">Whangaparāoa</dt>
          <dd class="mt-1">Back from the Gulf Harbour ramp on Laurie Southwick Parade after a day around Tiritiri Matangi or Kawau.</dd>
        </div>
        <div>
          <dt class="sub">Beachlands and Maraetai</dt>
          <dd class="mt-1">Home from Sunkist Bay, the Maraetai Park ramp or Omana Esplanade after a run out to Waiheke or Ponui.</dd>
        </div>
      </dl>
    </div>
  </section>
  <section class="bg-beige-2">
    <div class="wrap band">
      <div class="inset flow">
        <h2>Someone to clean my boat, without towing it anywhere</h2>
        <p>You’ve already done the drive, the ramp and the retrieve. We bring everything to you and leave the driveway the way we found it.</p>
        <p>An Essential Reset covers the wash-down and the rubbish. Book a Valet and we’ll do any cabin or cuddy properly too.</p>
      </div>
    </div>
  </section>
</ServicePage>
