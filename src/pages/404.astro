<Base title="Page not found | Shore Leave" description="That page has drifted off. Head back to Shore Leave." noindex>
  <section class="wrap band min-h-[60svh] flex flex-col justify-center">
    <h1>This one's drifted off its mooring.</h1>
    <p class="mt-5 text-xl">The page isn't here. The rest of the site is.</p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href="/" class="btn btn-navy">Back to the home page</a>
      <a href="/book" class="link">Book a reset</a>
    </div>
  </section>
</Base>
