---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---

<Base title="Page not found | Shore Leave" description="That page has drifted off. Head back to Shore Leave." noindex>
  <section class="on-ink min-h-svh flex items-center pt-[var(--header)]">
    <div class="wrap">
      <div class="inset">
        <h1>This one’s drifted <span class="tint">off its mooring.</span></h1>
        <p class="lede">The page isn’t here. The rest of the site is.</p>
        <div class="flex flex-wrap gap-x-9 tint">
          <a href="/" class="go">Home <Arrow /></a>
          <a href="/book" class="go">Enquire now <Arrow /></a>
        </div>
      </div>
    </div>
  </section>
</Base>
