---
import { getImage, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Arrow from '../components/Arrow.astro';
import { general, restock, valet, pricing } from '../data/qa';
import { business, faqPage, organization, service, website } from '../lib/schema';
import deck from '../assets/photos/deck-sunpad.jpg';
import pontoon from '../assets/photos/pontoon.jpg';
import poster from '../assets/photos/hero-poster.jpg';
import posterMobile from '../assets/photos/hero-poster-m.jpg';
import film from '../assets/video/hero.mp4?url';
import filmMobile from '../assets/video/hero-m.mp4?url';

const faqs = [valet[0], restock[0], pricing[1], valet[1], general[1]];
const schema = [
  business(),
  website(),
  organization(),
  service('Post-trip boat reset', 'Deck wash-down, rubbish removed, surfaces wiped, interior vacuumed, beds remade and fridge cleared.', '/boat-valet-auckland'),
  service('Boat fridge and pantry restock', 'Fridge and pantry stocked to your list, with drinks, ice, snacks and groceries delivered aboard.', '/boat-fridge-restock'),
  faqPage(faqs),
];

// The first frame of the film, so the hero is painted before the video arrives
const wide = await getImage({ src: poster, format: 'avif', width: 1440, quality: 50 });
const tall = await getImage({ src: posterMobile, format: 'avif', width: 540, quality: 50 });
const fallback = await getImage({ src: poster, format: 'jpg', width: 1280, quality: 60 });
// The tall cut only suits tall screens, so a narrow landscape window still gets the wide film
const PHONE = '(max-aspect-ratio: 4/5)';
const DESK = '(min-aspect-ratio: 4/5)';

const services = [
  { title: 'The reset', text: 'You walk off. We wash the deck, clear the rubbish, vacuum inside, remake the beds and empty the fridge.', href: '/boat-valet-auckland' },
  { title: 'The restock', text: 'Send us a list. Fridge and pantry stocked, drinks and ice aboard, groceries put away.', href: '/boat-fridge-restock' },
  { title: 'North Shore', text: 'Berth or trailer, Devonport to Long Bay. Tie up or tow home, and we’ll take it from there.', href: '/boat-cleaning-north-shore' },
  { title: 'Pine Harbour berths', text: 'Tie up and go home. We reset the boat right there on the berth.', href: '/pine-harbour-boat-cleaning' },
  { title: 'Trailer boats', text: 'Back from the ramp? We come to your driveway on the North Shore, in Whangaparāoa, Beachlands and Maraetai.', href: '/trailer-boat-cleaning' },
  { title: 'East Auckland', text: 'Beachlands, Maraetai and the ramps around them. We’re local to this end of the coast.', href: '/boat-cleaning-east-auckland' },
];
---

<Base
  title="Shore Leave | Boat valet and fridge restock, Auckland"
  description="Get off the boat. We’ll reset it. Boat cleaning, made beds and a stocked fridge in Auckland, on the berth or trailer, from the North Shore to Pine Harbour."
  schema={schema}
>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/avif" href={wide.src} media={DESK} fetchpriority="high" />
    <link rel="preload" as="image" type="image/avif" href={tall.src} media={PHONE} fetchpriority="high" />
  </Fragment>

  <section class="hero">
    <picture>
      <source media={PHONE} srcset={tall.src} type="image/avif" />
      <source media={DESK} srcset={wide.src} type="image/avif" />
      <img src={fallback.src} alt="White motor launch sitting on calm blue water off a pine-lined Auckland shore" fetchpriority="high" />
    </picture>
    <video data-hero-video autoplay muted loop playsinline preload="auto" aria-hidden="true">
      <source media={PHONE} src={filmMobile} type="video/mp4" />
      <source src={film} type="video/mp4" />
    </video>
    <div class="wrap">
      <div class="inset">
        <h1 class="rise">Get off the boat.<br /><span class="tint">We’ll reset it.</span></h1>
        <p class="lede rise rise-2">Berths and trailer boats, from the North Shore to Pine Harbour.</p>
        <div class="rise rise-3 tint flex flex-wrap gap-x-9">
          <a href="#what-we-do" class="go">What we do <Arrow /></a>
          <a href="/book" class="go" data-hero-cta data-track="click_book_cta">Enquire now <Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="on-ink">
    <div class="wrap band">
      <div class="inset flow">
        <p class="statement">Sunday, five o’clock. Everyone’s wrecked. The deck’s a mess and the fridge is warm.</p>
        <p class="lede text-beige">So the boat sits like that until next time. We take that part off your hands.</p>
        <a href="/about" class="go tint">Our story <Arrow /></a>
      </div>
    </div>
  </section>

  <section id="what-we-do" class="wrap band">
    <div class="inset flow">
      <h2 class="title">What we do</h2>
      <p class="lede">Two moments. We look after both. After the trip, and before the next one.</p>
    </div>
    <div class="mt-10 lg:mt-14 grid md:grid-cols-2 gap-4">
      {
        services.map((s) => (
          <article class="card flow">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <a href={s.href} class="go" aria-label={`Learn more about ${s.title.toLowerCase()}`}>Learn more <Arrow /></a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="banner">
    <!-- REPLACE WITH OWN PHOTO: a real reset, made up and ready -->
    <Picture src={deck} formats={['avif', 'webp']} widths={[640, 1000, 1600]} sizes="100vw" alt="Deck lounge on a modern boat with tan cushions laid out neatly, moored at a marina" quality={55} data-replace="own-photo" />
    <div class="wrap">
      <div class="inset flow">
        <p class="statement">Hotels don’t ask you to change the sheets before you check out. Neither do we.</p>
        <a href="/how-it-works" class="go tint">How it works <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="on-beige">
    <div class="wrap band">
      <div class="inset flow">
        <h2 class="title">Three steps</h2>
        <ol class="steps">
          <li>
            <b>1</b>
            <h3>Book</h3>
            <p>Tell us about the boat. We’ll send a quote.</p>
          </li>
          <li>
            <b>2</b>
            <h3>We reset</h3>
            <p>We get aboard the way we agreed and work through the list. You don’t need to be there.</p>
          </li>
          <li>
            <b>3</b>
            <h3>You come back</h3>
            <p>Clean decks. Made beds. A cold, stocked fridge if you asked for one.</p>
          </li>
        </ol>
        <a href="/how-it-works" class="go">Keys, access and what we need from you <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="banner">
    <Picture src={pontoon} formats={['avif', 'webp']} widths={[640, 1000, 1600]} sizes="100vw" alt="Calm water and a floating pontoon, with moored yachts and a green hillside behind" quality={55} data-replace="own-photo" />
    <div class="wrap">
      <div class="inset flow">
        <p class="statement">Every boat’s different, so every quote is too.</p>
        <p class="lede">Tell us what you’ve got. You’ll get a straight price before anything starts.</p>
        <a href="/pricing" class="go tint">How quotes work <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="wrap band">
    <div class="inset flow">
      <h2 class="title">Where we work</h2>
      <p class="lede">Two sides of the Gulf. On the berth or on the trailer, at both.</p>
    </div>
    <div class="mt-10 grid md:grid-cols-2 gap-4">
      <article class="card flow">
        <h3>North Shore</h3>
        <p>Berths and trailer boats, from Devonport up to Long Bay, plus Whangaparāoa.</p>
        <a href="/boat-cleaning-north-shore" class="go" aria-label="Boat cleaning on the North Shore">See the North Shore <Arrow /></a>
      </article>
      <article class="card flow">
        <h3>East Auckland</h3>
        <p>Berths at <a class="underline" href="/pine-harbour-boat-cleaning">Pine Harbour Marina</a>, and trailer boats in <a class="underline" href="/boat-cleaning-beachlands">Beachlands</a> and Maraetai.</p>
        <a href="/boat-cleaning-east-auckland" class="go" aria-label="Boat cleaning in East Auckland">See East Auckland <Arrow /></a>
      </article>
    </div>
  </section>

  <section class="bg-beige-2">
    <div class="wrap band">
      <div class="inset flow">
        <h2 class="title">We’d rather earn the first review than fake it.</h2>
        <p class="lede">We’re new. No reviews, no logos, no made-up numbers. Our first boats get Zak or Bozzy on the job, a straight quote and a direct line if anything isn’t right.</p>
      </div>
    </div>
  </section>

  <section class="wrap band">
    <Faq items={faqs} heading="Good questions" />
    <div class="inset mt-6"><a href="/faq" class="go">All the questions <Arrow /></a></div>
  </section>

  <Cta />
</Base>

<style is:global>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    height: 100svh;
    min-height: 34rem;
    background: var(--color-ink);
    color: #fff;
    isolation: isolate;
    overflow: hidden;
  }
  .hero img,
  .hero video {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero video {
    opacity: 0;
    transition: opacity 0.6s linear;
  }
  .hero video.on {
    opacity: 1;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(32 30 27 / 0.45), rgb(32 30 27 / 0) 30%),
      linear-gradient(90deg, rgb(32 30 27 / 0.72), rgb(32 30 27 / 0.3));
  }
  .hero .inset > * + * {
    margin-top: 1.5rem;
  }
  /* Sized so each sentence holds one line on a phone */
  .hero h1 {
    font-size: clamp(2rem, 11.6vw, 6.5rem);
    line-height: 0.96;
  }
  @media (max-width: 47.99rem) {
    .hero::after {
      background: linear-gradient(180deg, rgb(32 30 27 / 0.6), rgb(32 30 27 / 0.5) 50%, rgb(32 30 27 / 0.6));
    }
  }
</style>

<script is:inline>
  // The film plays for everyone. The loader waits for it, up to its cap, and if a phone blocks autoplay
  // (low power mode) the poster holds until the visitor's first touch or scroll starts it.
  (function () {
    var v = document.querySelector('[data-hero-video]');
    var ready = function () { if (window.slReady) slReady(); };
    function go() {
      v.muted = true;
      var p = v.play();
      if (p) p.catch(ready);
    }
    v.addEventListener('playing', function () { v.classList.add('on'); ready(); }, { once: true });
    v.addEventListener('canplay', go);
    v.querySelector('source:last-child').addEventListener('error', ready, { once: true });
    document.addEventListener('visibilitychange', function () { if (!document.hidden) go(); });
    ['pointerdown', 'touchstart', 'scroll', 'keydown'].forEach(function (e) {
      addEventListener(e, function () { if (v.paused) go(); }, { once: true, passive: true });
    });
    go();
  })();
</script>
