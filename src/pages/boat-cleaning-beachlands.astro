---
import ServicePage from '../layouts/ServicePage.astro';
import { beachlands } from '../data/qa';
import photo from '../assets/photos/pontoon.jpg';
---

<ServicePage
  title="Boat Cleaning Beachlands | Berth or driveway | Shore Leave"
  description="Boat cleaning in Beachlands, at Pine Harbour Marina or on the trailer at home. Local launch at Sunkist Bay? We’ll reset the boat when you’re back."
  crumb="Boat cleaning Beachlands"
  h1="Boat cleaning in Beachlands. We’re local to your ramp."
  lede="Pine Harbour berth or Sunkist Bay ramp, the reset’s the same. We come to wherever the boat ends up."
  photo={photo}
  photoAlt="Calm water and a floating pontoon, with moored yachts and a green hillside behind"
  faqs={beachlands}
  serviceName="Boat cleaning in Beachlands"
  og="beachlands"
  links={[
    { href: '/book', label: 'Enquire now' },
    { href: '/pricing', label: 'How quotes work' },
    { href: '/pine-harbour-boat-cleaning', label: 'Pine Harbour Marina' },
    { href: '/trailer-boat-cleaning', label: 'Trailer boats at home' },
  ]}
>
  <section class="wrap band">
    <div class="inset flow">
      <h2 class="title">Two kinds of Beachlands boat</h2>
      <div class="grid gap-6">
        <div>
          <h3 class="sub">On the berth at Pine Harbour</h3>
          <p class="mt-1">Launches and yachts that head to Waiheke or Ponui for the weekend. We reset them where they lie, with no need for you to come back down.</p>
        </div>
        <div>
          <h3 class="sub">On the trailer, off Sunkist Bay</h3>
          <p class="mt-1">Two concrete ramps, one by the seawall at the far end and one below the jetty. Check the tide before you commit. Once you’re home, we’ll take it from there.</p>
        </div>
      </div>
    </div>
  </section>
</ServicePage>
