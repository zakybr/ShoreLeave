---
import ServicePage from '../layouts/ServicePage.astro';
import { beachlands } from '../data/qa';
import photo from '../assets/photos/pontoon.jpg';
---

<ServicePage
  place
  title="Boat Cleaning Beachlands | Pine Harbour Berths | Shore Leave"
  description="Boat cleaning in Beachlands, on your berth at Pine Harbour Marina. Post-trip clean-ups, beds made and the fridge restocked, ready for next time."
  crumb="Boat cleaning Beachlands"
  h1="Boat cleaning in Beachlands. Local to your berth."
  lede="Berthed at Pine Harbour? Tie up and head home. We’ll reset the boat where it lies."
  photo={photo}
  photoAlt="Calm water and a floating pontoon, with moored yachts and a green hillside behind"
  faqs={beachlands}
  serviceName="Boat cleaning in Beachlands"
  og="beachlands"
>
  <section class="wrap band">
    <div class="inset flow">
      <h2 class="title">Looked after on the berth</h2>
      <div class="grid gap-6">
        <div>
          <h3 class="sub">On the berth at Pine Harbour</h3>
          <p class="mt-1">Launches and yachts that head to Waiheke or Ponui for the weekend. We reset them where they lie, with no need for you to come back down.</p>
        </div>
        <div>
          <h3 class="sub">Ready before the next trip</h3>
          <p class="mt-1">Send us your list and we’ll stock the fridge and pantry down the pontoon. The beds are made and the boat’s ready when you are.</p>
        </div>
      </div>
    </div>
  </section>
</ServicePage>
