---
import ServicePage from '../layouts/ServicePage.astro';
import { eastAuckland } from '../data/qa';
import photo from '../assets/photos/ropes.jpg';
---

<ServicePage
  title="Boat Cleaning East Auckland | Maraetai | Shore Leave"
  description="Boat cleaning in East Auckland. Trailer boat wash at home in Maraetai and Beachlands, plus berth resets at Pine Harbour. Fridge restocks too."
  crumb="Boat cleaning East Auckland"
  h1="East Auckland boats, reset where they sit."
  lede="From Pine Harbour round to Maraetai, we look after boats at the eastern end of the coast. If you're further west, ask. We'll be straight with you."
  photo={photo}
  photoAlt="Heavy rope coiled around a pair of bollards on a boat's deck"
  faqs={eastAuckland}
  serviceName="Boat cleaning in East Auckland"
  og="east-auckland"
  links={[
    { href: '/book', label: 'Book a reset' },
    { href: '/pricing', label: 'How quotes work' },
    { href: '/boat-cleaning-beachlands', label: 'Beachlands' },
    { href: '/trailer-boat-cleaning', label: 'Trailer boats at home' },
  ]}
>
  <section class="wrap band">
    <h2 class="max-w-[18ch]">The ramps we know, and how we cover them</h2>
    <div class="mt-10 grid md:grid-cols-3 gap-10 md:gap-8">
      <div class="border-t border-navy pt-4">
        <h3>Maraetai</h3>
        <p class="mt-2">A concrete ramp at Maraetai Park and a timber ramp off Omana Esplanade. Trailer callouts cover the whole area, so tow home and let us know.</p>
      </div>
      <div class="border-t border-navy pt-4">
        <h3>Beachlands</h3>
        <p class="mt-2">Sunkist Bay Reserve for trailer boats, Pine Harbour Marina for berths. This is where we spend most of our time.</p>
      </div>
      <div class="border-t border-navy pt-4">
        <h3>Half Moon Bay, Howick and Bucklands Beach</h3>
        <p class="mt-2">Half Moon Bay's all-tide ramp at Ara Tai Esplanade Reserve is a popular launch. These suburbs sit outside our regular run, so send your address and we'll tell you honestly if we can do it.</p>
      </div>
    </div>
  </section>
  <section class="bg-sand-2">
    <div class="wrap band lg:grid lg:grid-cols-12 lg:gap-12">
      <h2 class="lg:col-span-5">Trailer boat wash, East Auckland style</h2>
      <p class="lg:col-span-6 lg:col-start-7 mt-4 lg:mt-2">Most East Auckland trailer boats do short, hard days: out to Waiheke, Rakino or the Firth, and back the same night. They come home salty and full of gear. A reset the next day keeps the boat ready for the next good forecast.</p>
    </div>
  </section>
</ServicePage>
