---
import ServicePage from '../layouts/ServicePage.astro';
import Arrow from '../components/Arrow.astro';
import { pineHarbour } from '../data/qa';
import photo from '../assets/photos/marina-walkway.jpg';
---

<ServicePage
  place
  title="Boat Cleaning Pine Harbour Marina | Shore Leave"
  description="Boat cleaning at Pine Harbour Marina, Beachlands. We look after your boat on the berth: clean, beds made, fridge stocked. You just leave it and go home."
  crumb="Pine Harbour boat cleaning"
  h1="Pine Harbour Marina, on your berth."
  lede="Tie up, grab your bag and walk up the pontoon. We’ll reset the boat on the berth."
  photo={photo}
  photoAlt="Pontoon walkway running between berthed boats at a marina"
  faqs={pineHarbour}
  serviceName="Boat cleaning at Pine Harbour Marina"
  og="pine-harbour"
>
  <section class="wrap band">
    <div class="inset flow">
      <h2>Built around how Pine Harbour gets used</h2>
      <p>Waiheke, Ponui and the Coromandel are all an easy run from here. That means plenty of weekends away, and plenty of boats that come home needing a proper going-over.</p>
      <p>Berth holders use us two ways. A one-off reset after a big trip, or a standing arrangement: a clean after each weekend away, then provisioning before the next one.</p>
    </div>
  </section>
  <section class="bg-beige-2">
    <div class="wrap band">
      <div class="inset flow">
        <h2>Boat grocery delivery to your berth</h2>
        <p>Tell us your pier and berth and when you’re leaving. We shop your list, bring it down the pontoon and stow it aboard.</p>
        <a class="go" href="/boat-provisioning-auckland">How Provisioning works <Arrow /></a>
      </div>
    </div>
  </section>
</ServicePage>
