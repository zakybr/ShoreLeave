---
import { SITE } from '../config';
import Arrow from './Arrow.astro';
---

<dialog id="offer" aria-labelledby="offer-h">
  <button type="button" class="x" data-offer-close aria-label="Close this offer">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 2l16 16M18 2L2 18"></path></svg>
  </button>

  <div id="offer-ask">
    <p class="eyebrow">First reset, 50% off</p>
    <h2 id="offer-h" class="title">Half price.<br /><span class="text-stone">Full reset.</span></h2>
    <p class="mt-3">Leave your number. We’ll text you a quote with the 50% already off.</p>
    <form id="offer-form" class="mt-4 grid gap-3" method="post" action="/api/book" novalidate>
      <div class="grid grid-cols-2 gap-3">
        <div class="field"><label for="o-name">Name</label><input id="o-name" name="name" autocomplete="name" required /></div>
        <div class="field"><label for="o-mobile">Mobile</label><input id="o-mobile" name="mobile" type="tel" autocomplete="tel" inputmode="tel" required /></div>
      </div>
      <div class="field">
        <label for="o-boat">Where’s the boat?</label>
        <select id="o-boat" name="boat_type" required>
          <option value="">Choose one</option>
          <option>Berthed on the North Shore</option>
          <option>Berthed at Pine Harbour</option>
          <option>Trailer boat at home</option>
          <option>Other</option>
        </select>
      </div>
      <div style="position:absolute;left:-9999px" aria-hidden="true">
        <label for="o-company">Company</label><input id="o-company" name="company" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="t" id="o-t" />
      <input type="hidden" name="offer" value="50% off first reset" />
      <input type="hidden" name="consent" value="yes" />
      <p id="o-err" role="alert" class="font-semibold empty:hidden"></p>
      <button type="submit" id="o-go" class="btn btn-ink w-full">Claim my 50% off <Arrow /></button>
    </form>
    <p class="small">First Essential Reset only, one per boat. We only use your details to reply. <a href="/privacy" class="underline">Privacy</a> and <a href="/terms" class="underline">terms</a>.</p>
    <button type="button" class="no" data-offer-close>No thanks</button>
  </div>

  <div id="offer-done" hidden>
    <h2 class="title" tabindex="-1">You’re in.</h2>
    <p class="mt-3">Zak or Bozzy will text you shortly. Quote first, 50% off, no obligation.</p>
    <p class="small">In a hurry? Call {SITE.phoneDisplay}.</p>
    <button type="button" class="btn btn-ink w-full mt-5" data-offer-close>Back to the site</button>
  </div>
</dialog>

<style is:global>
  #offer {
    width: min(100%, 28rem);
    max-width: 100%;
    max-height: 100dvh;
    margin: auto;
    padding: 2rem 1.75rem 1.25rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 0;
    border-radius: 0.75rem;
    background: var(--color-paper);
    color: var(--color-ink);
  }
  #offer[open] {
    animation: offer-in 0.45s var(--ease-tide);
  }
  #offer::backdrop {
    background: rgb(32 30 27 / 0.6);
  }
  html:has(#offer[open]) {
    overflow: hidden;
  }
  @keyframes offer-in {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }
  /* A sheet on phones, so the page stays visible behind it and a thumb reaches everything */
  @media (max-width: 47.99rem) {
    #offer {
      width: 100%;
      margin: auto 0 0;
      max-height: 92dvh;
      border-radius: 0.75rem 0.75rem 0 0;
      padding: 1.5rem 1.25rem calc(0.5rem + env(safe-area-inset-bottom));
    }
    @keyframes offer-in {
      from {
        transform: translateY(100%);
      }
    }
  }
  #offer .x {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    cursor: pointer;
  }
  #offer .x:hover {
    background: var(--color-beige-2);
  }
  #offer .eyebrow {
    margin-bottom: 0.5rem;
    font-weight: 700;
    font-size: 0.9rem;
  }
  #offer .title {
    font-size: clamp(2.3rem, 10vw, 3.25rem);
  }
  #offer .field label {
    font-size: 0.9rem;
  }
  #offer .small {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--color-stone);
  }
  #offer .no {
    display: block;
    width: 100%;
    min-height: 2.75rem;
    margin-top: 0.25rem;
    color: var(--color-stone);
    text-decoration: underline;
    cursor: pointer;
  }
</style>

<script is:inline>
  (function () {
    var box = document.getElementById('offer');
    var KEY = 'sl-offer-2', WEEK = 7 * 864e5;
    var store = {
      get: function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } },
      set: function (k, v) { try { localStorage.setItem(k, v); } catch (e) {} },
    };
    function open() {
      if (box.open) return;
      document.getElementById('o-t').value = Date.now();
      box.showModal();
      // Keep focus off the first field so phones don't jump the keyboard up on arrival
      box.querySelector('.x').focus();
      if (window.slTrack) slTrack('offer_view');
    }
    function close() { box.close(); }
    box.addEventListener('close', function () {
      if (store.get(KEY) !== 'claimed') store.set(KEY, Date.now());
    });
    box.addEventListener('click', function (e) {
      if (e.target === box || e.target.closest('[data-offer-close]')) close();
    });
    // Links anywhere on the site can reopen it, dismissed or not
    document.addEventListener('click', function (e) {
      var t = e.target.closest && e.target.closest('[data-offer-open]');
      if (t) { e.preventDefault(); open(); }
    });

    var form = document.getElementById('offer-form');
    var err = document.getElementById('o-err'), go = document.getElementById('o-go');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      err.textContent = '';
      if (!form.reportValidity()) return;
      var label = go.innerHTML;
      go.disabled = true;
      go.textContent = 'Sending';
      fetch('/api/book', {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      }).then(function (res) {
        return res.json().catch(function () { return {}; }).then(function (out) {
          if (!res.ok) throw new Error(out.error);
          store.set(KEY, 'claimed');
          document.getElementById('offer-ask').hidden = true;
          var done = document.getElementById('offer-done');
          done.hidden = false;
          done.querySelector('.title').focus();
          if (window.slTrack) slTrack('generate_lead');
        });
      }).catch(function (x) {
        err.textContent = x.message || 'That did not send. Call or text 022 305 3853 and we will sort it out.';
        go.disabled = false;
        go.innerHTML = label;
      });
    });

    function afterLoader(fn) {
      if (document.documentElement.classList.contains('loading')) addEventListener('sl-loaded', fn, { once: true });
      else fn();
    }
    // Any page with ?offer opens it straight away, ignoring what the browser remembers. For testing.
    if (/[?&]offer\b/.test(location.search)) return afterLoader(open);

    // Automatic opening: once per visit, never on the pages where it would get in the way
    var seen = store.get(KEY);
    var quiet = /^\/(book|privacy|terms)/.test(location.pathname);
    if (quiet || seen === 'claimed' || (seen && Date.now() - seen < WEEK)) return;
    try { if (sessionStorage.getItem(KEY)) return; } catch (e) {}
    var armed = true, timer;
    function fire() {
      if (!armed || document.documentElement.classList.contains('menu-open')) return;
      var a = document.activeElement;
      if (a && /INPUT|SELECT|TEXTAREA/.test(a.tagName)) return;
      armed = false;
      clearTimeout(timer);
      try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
      open();
    }
    function arm() {
      timer = setTimeout(fire, 15000);
      addEventListener('scroll', function () {
        var max = document.documentElement.scrollHeight - innerHeight;
        if (max > 0 && scrollY / max > 0.45) fire();
      }, { passive: true });
      document.addEventListener('mouseout', function (e) { if (!e.relatedTarget && e.clientY <= 0) fire(); });
    }
    afterLoader(arm);
  })();
</script>
