---
// Tracta-style reveal: a beige sheet with the logo cut out of it, so the live page shows through the
// silhouette, then the cut-out grows until the sheet is gone. Decorative, so hidden from assistive
// tech. It only exists while html.loading is set, which needs JavaScript, so crawlers and no-JS
// visitors never see it. It runs once per visit, on the first page, and doubles as the wait for the
// hero video: it lifts once the page is ready, after a short minimum and before a hard cap.
// The sheet and the logo are one path, cut out with even-odd fill. An SVG <mask> this large gets
// rasterised to a capped bitmap, which is what pixelated the edge on phones. A plain path stays vector.
import logo from '../assets/logo.svg?raw';
const shape = logo.match(/ d="([^"]+)"/)?.[1];
---

<div id="loader" aria-hidden="true">
  <svg viewBox="-583 -848 2400 2400" preserveAspectRatio="xMidYMid meet" shape-rendering="geometricPrecision">
    <path id="ls" d={`M-12000 -12000H12000V12000H-12000Z ${shape}`} fill="#d6c8b0" fill-rule="evenodd"></path>
  </svg>
  <div class="hud"><div id="lb"></div></div>
</div>

<style is:inline>
  #loader { display: none; }
  html.loading #loader {
    display: block; position: fixed; inset: 0; z-index: 100; overflow: hidden; cursor: default;
    animation: sl-failsafe 0.01s linear 4s forwards;
  }
  @keyframes sl-failsafe { to { visibility: hidden; } }
  #loader svg { display: block; width: 100%; height: 100%; }
  #loader .hud { position: absolute; left: 50%; bottom: max(8vh, 3.25rem); width: min(calc(100% - 4rem), 16rem); height: 2px; transform: translateX(-50%); background: rgba(43,42,40,.2); transition: opacity .2s linear; }
  #loader #lb { height: 100%; background: #2b2a28; transform: scaleX(0); transform-origin: left; }
  #loader.out { pointer-events: none; }
  #loader.out .hud { opacity: 0; }
</style>

<script is:inline>
  (function () {
    var d = document.documentElement;
    var el = document.getElementById('loader');
    if (!d.classList.contains('loading')) { el.remove(); return; }
    var lb = document.getElementById('lb'), ls = document.getElementById('ls');
    var MIN = 700, CAP = 2200, OUT = 850, start = performance.now(), ready = false, done = false, p = 0;
    // The middle of the hull, the widest solid part of the logo, so the cut-out opens from there
    var CX = 800, CY = 490, GROW = 46;
    window.slReady = function () { ready = true; };
    addEventListener('load', function () { if (!document.querySelector('[data-hero-video]')) ready = true; });
    function grow(t0) {
      return function step(now) {
        var t = Math.min((now - t0) / OUT, 1), e = t * t * t;
        var s = 1 + (GROW - 1) * e;
        ls.setAttribute('transform', 'translate(' + CX + ' ' + CY + ') scale(' + s + ') translate(' + -CX + ' ' + -CY + ')');
        if (t > 0.7) el.style.opacity = (1 - t) / 0.3;
        if (t < 1) requestAnimationFrame(step);
        else { d.classList.remove('loading'); el.remove(); dispatchEvent(new Event('sl-loaded')); }
      };
    }
    function finish() {
      if (done) return;
      done = true;
      lb.style.transform = 'scaleX(1)';
      el.classList.add('out');
      setTimeout(function () { d.classList.remove('hold'); }, 220);
      requestAnimationFrame(function (now) { grow(now)(now); });
    }
    function frame(now) {
      if (done) return;
      var t = now - start;
      // Eases towards 90% until the page reports ready, so a slow connection never reads as stuck
      p += ((ready && t >= MIN ? 1 : 0.9) - p) * 0.09;
      lb.style.transform = 'scaleX(' + p + ')';
      if ((ready && t >= MIN) || t >= CAP) finish(); else requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
    el.addEventListener('pointerdown', finish);
    addEventListener('keydown', finish, { once: true });
  })();
</script>
