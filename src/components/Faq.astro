---
import type { QA } from '../data/qa';
interface Props {
  items: QA[];
  heading?: string;
  open?: boolean;
}
const { items, heading, open = false } = Astro.props;
---

<div class="inset flow">
  {heading && <h2 class="title">{heading}</h2>}
  <div class="border-t border-current/20">
    {
      items.map(({ q, a }) => (
        <details class="border-b border-current/20 py-5" open={open}>
          <summary class="flex justify-between gap-6">
            <h3>{q}</h3>
            <span class="sum-mark" />
          </summary>
          <p class="mt-3">{a}</p>
        </details>
      ))
    }
  </div>
</div>
