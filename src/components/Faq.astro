---
import type { QA } from '../data/qa';
interface Props {
  items: QA[];
  heading?: string;
  open?: boolean;
}
const { items, heading, open = false } = Astro.props;
---

<div class="grid lg:grid-cols-12 gap-8">
  {heading && <h2 class="lg:col-span-4">{heading}</h2>}
  <div class:list={[heading ? 'lg:col-span-8' : 'lg:col-span-12', 'border-t border-current/20']}>
    {
      items.map(({ q, a }) => (
        <details class="border-b border-current/20 py-5" open={open}>
          <summary class="flex justify-between gap-6">
            <h3 class="!text-[1.3rem]">{q}</h3>
            <span class="sum-mark" />
          </summary>
          <p class="mt-3">{a}</p>
        </details>
      ))
    }
  </div>
</div>
