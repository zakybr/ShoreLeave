---
import { SITE } from '../config';
import Arrow from './Arrow.astro';
const { heading = "Leave the boat. We’ve got it from here.", book = '/book' } = Astro.props;
---

<section class="on-beige">
  <div class="wrap band">
    <div class="inset flow">
      <h2 class="title">{heading}</h2>
      <p class="lede">Tell us about the boat. You’ll get a quote before anything starts, and your first Essential Reset is 50% off.</p>
      <div class="flex flex-col items-start sm:flex-row sm:flex-wrap gap-x-9">
        <a href={book} class="go" data-track="click_book_cta">Enquire now <Arrow /></a>
        <button type="button" class="go cursor-pointer" data-offer-open>Claim 50% off <Arrow /></button>
        <a href={`tel:${SITE.phoneTel}`} class="go" data-track="click_call">Call {SITE.phoneDisplay} <Arrow /></a>
      </div>
    </div>
  </div>
</section>
