---
import { bookHref, SERVICES, SITE, WINTER } from '../config';
const path = Astro.url.pathname.replace(/\/$/, '');
const offered = SERVICES.find((s) => s.href === path);
const winter = path === WINTER.href;
const book = winter ? '#register' : offered ? bookHref(offered.label) : '/book';
---

<div id="mbar" class="lg:hidden fixed inset-x-0 bottom-0 z-40 grid grid-cols-[1fr_auto_auto] bg-ink text-paper pb-[env(safe-area-inset-bottom)]">
  <a href={book} class="btn btn-beige !rounded-none !min-h-14" data-track="click_book_cta">{winter ? 'Register for winter' : 'Enquire now'}</a>
  <a href={`sms:${SITE.phoneTel}`} class="btn !min-h-14 !px-5 no-underline" data-track="click_sms">Text</a>
  <a href={`tel:${SITE.phoneTel}`} class="btn !min-h-14 !px-5 no-underline" data-track="click_call">Call</a>
</div>

<script is:inline>
  (function () {
    var d = document.documentElement, cta = document.querySelector('[data-hero-cta]');
    if (!cta || !('IntersectionObserver' in window)) { d.classList.remove('bar-hold'); return; }
    new IntersectionObserver(function (e) { d.classList.toggle('bar-hold', e[0].isIntersecting); }).observe(cta);
  })();
</script>
