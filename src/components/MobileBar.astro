---
import { SITE } from '../config';
---

<div class="lg:hidden fixed inset-x-0 bottom-0 z-40 grid grid-cols-[1fr_auto_auto] bg-navy text-sand pb-[env(safe-area-inset-bottom)]">
  <a href="/book" class="btn btn-brass !min-h-14" data-track="click_book_cta">Book a reset</a>
  <a href={`sms:${SITE.phoneTel}`} class="btn !min-h-14 !px-5 no-underline" data-track="click_sms">Text</a>
  <a href={`tel:${SITE.phoneTel}`} class="btn !min-h-14 !px-5 no-underline" data-track="click_call">Call</a>
</div>
