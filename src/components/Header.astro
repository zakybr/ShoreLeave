---
import { NAV, SITE } from '../config';
import Mark from './Mark.astro';
import Arrow from './Arrow.astro';
const here = Astro.url.pathname;
---

<header id="top" class="text-white">
  <div class="wrap flex items-center justify-between h-[var(--header)]">
    <a href="/" id="brand" class="relative z-10 flex items-center gap-2.5 no-underline" aria-label={`${SITE.name} home`}>
      <Mark />
      <span class="font-display text-[1.45rem] uppercase tracking-[0.02em]">{SITE.name}</span>
    </a>
    <button id="menu-btn" type="button" class="relative z-10 flex items-center gap-3 min-h-11 -mr-1 px-1" aria-expanded="false" aria-controls="menu">
      <span id="menu-label">Menu</span>
      <span class="burger" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div id="menu" class="on-ink" inert>
    <div class="wrap menu-grid">
      <nav aria-label="Main">
        <ul>
          {
            NAV.map((n, i) => (
              <li style={`--i:${i}`}>
                <a href={n.href} aria-current={here === n.href ? 'page' : undefined}>{n.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="menu-side" style={`--i:${NAV.length}`}>
        <div class="menu-brand">
          <Mark size={52} />
          <span class="font-display text-[2.1rem] uppercase tracking-[0.02em]">{SITE.name}</span>
        </div>
        <p class="lede">Clean decks, made beds and a cold fridge. On the berth or the trailer, from the North Shore to Pine Harbour.</p>
        <a href="/book" class="go text-beige" data-track="click_book_cta">Enquire now <Arrow /></a>
        <ul class="menu-more">
          <li><a href={`tel:${SITE.phoneTel}`} data-track="click_call">{SITE.phoneDisplay}</a></li>
          <li><a href={`sms:${SITE.phoneTel}`} data-track="click_sms">Text us</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/faq">FAQ</a></li>
        </ul>
      </div>
    </div>
  </div>
</header>

<style is:global>
  #top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    transition:
      background-color 0.35s var(--ease-tide),
      transform 0.35s var(--ease-tide);
  }
  #top.solid {
    background: var(--color-ink);
  }
  html.menu-open #top {
    background: transparent;
  }
  html.menu-open {
    overflow: hidden;
  }
  .burger {
    display: grid;
    gap: 0.5rem;
    width: 1.8rem;
  }
  .burger i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.35s var(--ease-tide);
  }
  html.menu-open .burger i:first-child {
    transform: translateY(0.3rem) rotate(45deg);
  }
  html.menu-open .burger i:last-child {
    transform: translateY(-0.3rem) rotate(-45deg);
  }
  #menu {
    position: fixed;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 0.35s var(--ease-tide),
      visibility 0s linear 0.35s;
  }
  html.menu-open #menu {
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }
  .menu-grid {
    display: grid;
    gap: 2.25rem;
    align-content: center;
    min-height: 100%;
    padding-block: calc(var(--header) + 1rem) 2.5rem;
  }
  .menu-brand {
    display: none;
    align-items: center;
    gap: 0.9rem;
    color: #fff;
  }
  /* Two even columns, both centred on the same line, so the sides balance */
  @media (min-width: 48rem) {
    .menu-grid {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      column-gap: clamp(2rem, 5vw, 5rem);
      padding-inline-start: calc(var(--gutter) + var(--indent));
    }
    .menu-brand {
      display: flex;
    }
    /* The logo moves into the right column while the menu is open */
    #brand {
      transition: opacity 0.25s linear;
    }
    html.menu-open #brand {
      opacity: 0;
      pointer-events: none;
    }
  }
  #menu nav li a {
    display: block;
    padding-block: clamp(0.2rem, 1.2svh, 0.6rem);
    font-weight: 300;
    font-size: clamp(1.75rem, min(3.8vw, 6svh), 2.75rem);
    line-height: 1.16;
    text-decoration: none;
    transition: color 0.2s linear;
  }
  #menu nav li a:hover,
  #menu nav li a[aria-current='page'] {
    color: var(--color-beige);
  }
  #menu nav li,
  .menu-side {
    opacity: 0;
    transform: translateY(1rem);
  }
  html.menu-open #menu nav li,
  html.menu-open .menu-side {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s var(--ease-tide),
      transform 0.6s var(--ease-tide);
    transition-delay: calc(var(--i) * 35ms + 80ms);
  }
  .menu-side {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  @media (max-width: 47.99rem) and (max-height: 44rem) {
    .menu-side .lede {
      display: none;
    }
  }
  .menu-more {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  .menu-more a {
    display: inline-block;
    padding-block: 0.3rem;
    text-decoration: none;
  }
  .menu-more a:hover {
    text-decoration: underline;
  }
</style>

<script is:inline>
  (function () {
    var d = document.documentElement;
    var top = document.getElementById('top'), btn = document.getElementById('menu-btn');
    var menu = document.getElementById('menu'), label = document.getElementById('menu-label');
    function set(open) {
      d.classList.toggle('menu-open', open);
      btn.setAttribute('aria-expanded', open);
      label.textContent = open ? 'Close' : 'Menu';
      menu.inert = !open;
    }
    btn.addEventListener('click', function () { set(!d.classList.contains('menu-open')); });
    addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && d.classList.contains('menu-open')) { set(false); btn.focus(); }
    });
    addEventListener('pageshow', function () { set(false); });
    function solid() { top.classList.toggle('solid', scrollY > 40); }
    addEventListener('scroll', solid, { passive: true });
    solid();
  })();
</script>
