---
import { NAV, SITE } from '../config';
import Mark from './Mark.astro';
const here = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-sand/95 border-b border-navy/10">
  <div class="wrap flex items-center justify-between gap-6 h-16 lg:h-20">
    <a href="/" class="flex items-center gap-2.5 no-underline" aria-label={`${SITE.name} home`}>
      <Mark size={22} />
      <span class="font-display text-[1.35rem] tracking-tight">{SITE.name}</span>
    </a>

    <nav class="hidden lg:flex items-center gap-7" aria-label="Main">
      {
        NAV.map((n) => (
          <a href={n.href} class:list={['no-underline hover:underline', here === n.href && 'underline']} aria-current={here === n.href ? 'page' : undefined}>
            {n.label}
          </a>
        ))
      }
      <a href="/book" class="btn btn-navy !min-h-11 !py-2" data-track="click_book_cta">Book a reset</a>
    </nav>

    <details class="lg:hidden relative">
      <summary class="flex items-center gap-2 min-h-11 px-1 font-semibold">
        Menu <span class="sum-mark !mt-0"></span>
      </summary>
      <nav class="fixed left-0 right-0 top-16 bg-sand border-b border-navy/15 px-5 pb-6 pt-2" aria-label="Mobile">
        <ul class="grid">
          {
            [...NAV, { href: '/faq', label: 'FAQ' }, { href: '/about', label: 'About' }].map((n) => (
              <li>
                <a href={n.href} class="block py-3 font-display text-2xl no-underline border-b border-navy/10">
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
