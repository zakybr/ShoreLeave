---
const ga = import.meta.env.PUBLIC_GA4_ID ?? '';
const clarity = import.meta.env.PUBLIC_CLARITY_ID ?? '';
const needed = Boolean(ga || clarity);
---

{
  needed && (
    <div id="consent" hidden class="fixed inset-x-3 bottom-[4.5rem] lg:bottom-4 lg:left-auto lg:right-4 lg:max-w-sm z-50 bg-navy text-sand p-4">
      <p class="text-[0.95rem]">
        Can we use cookies to see how the site gets used? It helps us fix what's broken. <a href="/privacy" class="underline">Privacy</a>
      </p>
      <div class="mt-3 flex gap-3">
        <button type="button" data-consent="yes" class="btn btn-brass !min-h-11 !py-2">Yes, fine</button>
        <button type="button" data-consent="no" class="btn !min-h-11 !py-2 underline">No thanks</button>
      </div>
    </div>
  )
}

<script is:inline define:vars={{ ga, clarity }}>
  (function () {
    var KEY = 'sl-consent';
    function read() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
    function write(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
    function add(src) { var s = document.createElement('script'); s.async = true; s.src = src; document.head.appendChild(s); }
    function load() {
      if (ga) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date()); gtag('config', ga); add('https://www.googletagmanager.com/gtag/js?id=' + ga);
      }
      if (clarity) {
        window.clarity = window.clarity || function () { (window.clarity.q = window.clarity.q || []).push(arguments); };
        add('https://www.clarity.ms/tag/' + clarity);
      }
    }
    window.slTrack = function (name) {
      if (window.gtag) gtag('event', name);
      if (window.va) window.va('event', { name: name });
    };
    document.addEventListener('click', function (e) {
      var t = e.target.closest && e.target.closest('[data-track],[data-consent]');
      if (!t) return;
      if (t.dataset.track) window.slTrack(t.dataset.track);
      if (t.dataset.consent) {
        write(t.dataset.consent);
        document.getElementById('consent').hidden = true;
        if (t.dataset.consent === 'yes') load();
      }
    });
    var state = read();
    if (state === 'yes') load();
    else if (!state && document.getElementById('consent')) document.getElementById('consent').hidden = false;
  })();
</script>
