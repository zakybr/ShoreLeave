---
// The Shore Leave logo, inline so it paints with the page and takes the text colour.
import logo from '../assets/logo.svg?raw';
const { size = 36, class: cls = '' } = Astro.props;
const shape = logo.match(/ d="([^"]+)"/)?.[1];
---

<svg class={cls} height={size} width={(size * 1234) / 704} viewBox="0 0 1234 704" fill="currentColor" style="flex:none" aria-hidden="true"><path d={shape}></path></svg>
