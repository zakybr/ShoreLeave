---
// The Shore Leave logo. A CSS mask over /logo.svg, so it takes the text colour and loads once.
const { size = 36, class: cls = '' } = Astro.props;
const shape = 'url(/logo.svg) center / contain no-repeat';
---

<span class={cls} style={`display:inline-block;flex:none;height:${size}px;aspect-ratio:1234/704;background:currentColor;mask:${shape};-webkit-mask:${shape}`} aria-hidden="true"></span>
