---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from './Base.astro';
import Cta from '../components/Cta.astro';
import type { QA } from '../data/qa';
import { breadcrumbs, faqPage, service } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  crumb: string;
  h1: string;
  lede: string;
  photo?: ImageMetadata;
  photoAlt?: string;
  faqs?: QA[];
  serviceName?: string;
  og?: string;
  links?: { href: string; label: string }[];
  hideCta?: boolean;
  noindex?: boolean;
  ctaHeading?: string;
}
const { title, description, crumb, h1, lede, photo, photoAlt = '', faqs = [], serviceName, og, links = [], hideCta = false, noindex = false, ctaHeading } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const schema = [
  breadcrumbs([{ name: crumb, path }]),
  ...(serviceName ? [service(serviceName, description, path)] : []),
  ...(faqs.length ? [faqPage(faqs)] : []),
];
---

<Base title={title} description={description} schema={schema} og={og} noindex={noindex}>
  <div class="wrap pt-5">
    <nav aria-label="Breadcrumb" class="text-[0.92rem] text-slate">
      <ol class="flex flex-wrap gap-2">
        <li><a href="/" class="underline">Home</a> <span aria-hidden="true">/</span></li>
        <li aria-current="page">{crumb}</li>
      </ol>
    </nav>
  </div>

  <section class:list={['wrap', photo ? 'lg:grid lg:grid-cols-12 lg:gap-12 items-end pt-8 lg:pt-12' : 'pt-8 pb-10 lg:pt-12']}>
    <div class="lg:col-span-7 pb-8 lg:pb-14">
      <h1 class="!text-[clamp(2.5rem,7vw,5rem)]">{h1}</h1>
      <p class="mt-5 text-xl leading-snug max-w-[46ch]">{lede}</p>
      {!hideCta && <a href="/book" class="btn btn-navy mt-7" data-track="click_book_cta">Book a reset</a>}
    </div>
    {
      photo && (
        <div class="lg:col-span-5 -mx-[var(--gutter)] md:mx-0">
          <Picture src={photo} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 64rem) 40vw, 100vw" alt={photoAlt} class="w-full aspect-[5/4] lg:aspect-[4/5] object-cover" quality={58} loading="eager" fetchpriority="high" data-replace="own-photo" />
        </div>
      )
    }
  </section>

  {
    faqs.length > 0 && (
      <section class="on-navy">
        <div class="wrap band grid gap-12 lg:gap-16">
          {faqs.map(({ q, a }) => (
            <div class="lg:grid lg:grid-cols-12 lg:gap-12">
              <h2 class="lg:col-span-5 !text-[clamp(1.6rem,3vw,2.25rem)] !leading-[1.12]">{q}</h2>
              <p class="lg:col-span-6 lg:col-start-7 mt-3 lg:mt-1 text-lg text-sand/90">{a}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <div class="on-sand"><slot /></div>

  {
    links.length > 0 && (
      <nav class="wrap pb-14" aria-label="Related pages">
        <ul class="flex flex-wrap gap-x-7 gap-y-3 border-t border-navy/25 pt-6">
          {links.map((l) => <li><a class="link" href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    )
  }

  {!hideCta && <Cta heading={ctaHeading} />}
</Base>
