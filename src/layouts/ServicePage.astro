---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from './Base.astro';
import Cta from '../components/Cta.astro';
import Arrow from '../components/Arrow.astro';
import type { QA } from '../data/qa';
import { breadcrumbs, faqPage, service } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  crumb: string;
  h1: string;
  lede: string;
  photo?: ImageMetadata;
  photoAlt?: string;
  faqs?: QA[];
  serviceName?: string;
  og?: string;
  links?: { href: string; label: string }[];
  hideCta?: boolean;
  noindex?: boolean;
  ctaHeading?: string;
  book?: string;
}
const { title, description, crumb, h1, lede, photo, photoAlt = '', faqs = [], serviceName, og, links = [], hideCta = false, noindex = false, ctaHeading, book = '/book' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const schema = [
  breadcrumbs([{ name: crumb, path }]),
  ...(serviceName ? [service(serviceName, description, path)] : []),
  ...(faqs.length ? [faqPage(faqs)] : []),
];
// The last sentence of the headline takes the second colour, as on the home page
const sentences = h1.split(/(?<=[.?])\s+/);
const tail = sentences.length > 1 ? sentences.pop() : '';
const head = sentences.join(' ');
---

<Base title={title} description={description} schema={schema} og={og} noindex={noindex}>
  <section class:list={[photo ? 'banner' : 'on-ink', 'page-top']}>
    {photo && <Picture src={photo} formats={['avif', 'webp']} widths={[640, 1000, 1600]} sizes="100vw" alt={photoAlt} quality={55} loading="eager" fetchpriority="high" data-replace="own-photo" />}
    <div class="wrap">
      <div class="inset">
        <nav aria-label="Breadcrumb" class="text-[0.85rem] opacity-80">
          <ol class="flex flex-wrap gap-2">
            <li><a href="/" class="underline">Home</a> <span aria-hidden="true">/</span></li>
            <li aria-current="page">{crumb}</li>
          </ol>
        </nav>
        <h1 class="rise">{head}{tail && <><br /><span class="tint">{tail}</span></>}</h1>
        <p class="lede rise rise-2">{lede}</p>
        {!hideCta && <a href={book} class="go tint rise rise-3" data-track="click_book_cta">Enquire now <Arrow /></a>}
      </div>
    </div>
  </section>

  <slot />

  {
    faqs.length > 0 && (
      <section class="on-ink">
        <div class="wrap band">
          <div class="inset grid gap-10">
            {faqs.map(({ q, a }) => (
              <div class="flow !mt-0">
                <h2 class="!text-[clamp(1.45rem,2.6vw,1.85rem)]">{q}</h2>
                <p class="mt-2 text-paper/85">{a}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    links.length > 0 && (
      <nav class="wrap py-10" aria-label="Related pages">
        <ul class="inset flex flex-wrap gap-x-8 gap-y-1">
          {links.map((l) => <li class="!mt-0"><a class="go" href={l.href}>{l.label} <Arrow /></a></li>)}
        </ul>
      </nav>
    )
  }

  {!hideCta && <Cta heading={ctaHeading} book={book} />}
</Base>

<style is:global>
  .page-top {
    display: flex;
    align-items: center;
    min-height: min(78svh, 40rem);
    padding-block: calc(var(--header) + 2.5rem) 3.5rem;
  }
  .page-top h1 {
    font-size: clamp(2.75rem, 6.6vw, 4.75rem);
    text-wrap: balance;
  }
</style>
