---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/inter-tight/index.css';
import '../styles/global.css';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import { SITE } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Loader from '../components/Loader.astro';
import Consent from '../components/Consent.astro';

interface Props {
  title: string;
  description: string;
  og?: string;
  schema?: object[];
  loader?: boolean;
  noindex?: boolean;
}
const { title, description, og = 'home', schema = [], loader = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href.replace(/\/$/, '');
const ogImage = new URL(`/og/${og}.jpg`, SITE.url).href;
const gVerify = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bVerify = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0e2233" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_NZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {gVerify && <meta name="google-site-verification" content={gVerify} />}
    {bVerify && <meta name="msvalidate.01" content={bVerify} />}
    {schema.map((s) => <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {
      loader && (
        <script is:inline>
          (function () {
            try {
              var c = navigator.connection;
              var force = /[?&]loader\b/.test(location.search);
              if (force) document.documentElement.classList.add('loader-forced');
              else if (sessionStorage.getItem('sl-seen') || matchMedia('(prefers-reduced-motion: reduce)').matches || (c && c.saveData)) return;
              sessionStorage.setItem('sl-seen', '1');
              document.documentElement.classList.add('loading', 'hold');
              [1, 2, 3, 4, 5].forEach(function (n) { new Image().src = '/loader/' + n + '.webp'; });
            } catch (e) {}
          })();
        </script>
      )
    }
  </head>
  <body>
    <Fragment set:html={`<!--
THESIS: A boat hotel turndown, not a cleaning company. Refuses the blue-gradient trades template.
OWN-WORLD: Sand and navy fields, one brass field, the R signal-flag cross as mark, bullet and loader window. Fraunces at display cut, Inter Tight for text.
STORY: Owners see their worst Sunday named, believe the boat can be left as it is, and book from the pontoon.
FIRST VIEWPORT: Huge navy two-line promise left on sand, portrait deck-lounge photo bleeding right, brass-free navy primary button under the copy, call link beside it.
FORM: Brief-pinned direction; concept roll skipped because the owner pinned the aesthetic and asked not to be interviewed. Seed key: brief-pinned.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->`} />
    {loader && <Loader />}
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-navy focus:text-sand focus:p-3">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <MobileBar />
    <Consent />
  </body>
</html>
