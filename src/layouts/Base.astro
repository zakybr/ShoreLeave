---
import '@fontsource/anton/400.css';
import '@fontsource-variable/hanken-grotesk/wght.css';
import '../styles/global.css';
import antonUrl from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import { GA4_ID, SITE } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Loader from '../components/Loader.astro';
import Consent from '../components/Consent.astro';
import Offer from '../components/Offer.astro';

interface Props {
  title: string;
  description: string;
  og?: string;
  schema?: object[];
  noindex?: boolean;
}
const { title, description, og = 'home', schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href.replace(/\/$/, '');
const ogImage = new URL(`/og/${og}.jpg`, SITE.url).href;
const gVerify = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bVerify = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google tag, in Consent Mode: no analytics cookies until the visitor says yes -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
    <script is:inline define:vars={{ id: GA4_ID }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      var yes = false;
      try { yes = localStorage.getItem('sl-consent') === 'yes'; } catch (e) {}
      gtag('consent', 'default', {
        analytics_storage: yes ? 'granted' : 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });
      gtag('js', new Date());
      gtag('config', id);
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#2b2a28" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={antonUrl} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_NZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {gVerify && <meta name="google-site-verification" content={gVerify} />}
    {bVerify && <meta name="msvalidate.01" content={bVerify} />}
    {schema.map((s) => <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline>
      document.documentElement.classList.add('loading', 'hold', 'bar-hold');
      if ('IntersectionObserver' in window) document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <Fragment set:html={`<!--
THESIS: A boat hotel turndown, not a cleaning company. Refuses the blue-gradient trades template.
OWN-WORLD: Beige, dark grey and white, taken from the owner's brief and modelled on tracta.co.nz. Full-bleed film, Anton caps over light Hanken Grotesk, the boat-house logo as mark and loader window, the R flag cross as bullet.
STORY: Owners see their worst Sunday named, believe the boat can be left as it is, and enquire from the pontoon.
FIRST VIEWPORT: Full-screen film of a boat on the water, a two-tone caps promise set in from the left, two arrow links under it.
-->`} />
    <Loader />
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-ink focus:text-paper focus:p-3">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <MobileBar />
    <Offer />
    <Consent />
    <script is:inline>
      (function () {
        if (!document.documentElement.classList.contains('js')) return;
        var io = new IntersectionObserver(function (list) {
          list.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('.flow').forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
