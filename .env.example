# Set these in Vercel: Project > Settings > Environment Variables. Never commit real values.

# Required for the booking form
RESEND_API_KEY=
LEAD_TO_EMAIL=zak@tallynz.co
# Leave blank to use Resend's test sender, which only delivers to your Resend account email.
FROM_EMAIL=
# Set to "on" once the domain is verified in Resend.
CUSTOMER_CONFIRMATION=off

# Set when the real domain goes live. Controls canonicals, sitemap and schema.
PUBLIC_SITE_URL=

# Optional. Clarity only loads after consent. GA4 loads in Consent Mode and defaults to the ID in src/config.ts.
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=

# Search verification
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
