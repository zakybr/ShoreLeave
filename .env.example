# Set these in Vercel: Project > Settings > Environment Variables. Never commit real values.

# Required for the booking form
RESEND_API_KEY=
LEAD_TO_EMAIL=zak@tallynz.co
# Leave blank to use Resend's test sender, which only delivers to your Resend account email.
FROM_EMAIL=
# Set to "on" once the domain is verified in Resend.
CUSTOMER_CONFIRMATION=off

# Set when the real domain goes live. Controls canonicals, sitemap and schema.
PUBLIC_SITE_URL=

# Optional. Clarity only loads after consent. GA4 loads in Consent Mode and defaults to the ID in src/config.ts.
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=

# Search verification
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# Pre-launch waitlist cover (src/components/WaitlistCover.astro). Shows over every page until this ISO
# date, then switches itself off. Remove and redeploy to take it away. ?preview=site hides it on your browser.
PUBLIC_WAITLIST_UNTIL=
# Signs the step-2 token. Falls back to RESEND_API_KEY if blank.
WAITLIST_SECRET=
# Connect a Vercel Blob store to the project and it sets BLOB_READ_WRITE_TOKEN; signups are saved there.
BLOB_READ_WRITE_TOKEN=
# Lets you read signup counts: curl -H "Authorization: Bearer <token>" https://<site>/api/waitlist
WAITLIST_ADMIN_TOKEN=
